<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<OutputType>Exe</OutputType>
		<IsTestProject>true</IsTestProject>
		<AnalyzerPackageDirectory Condition="'$(AnalyzerPackageDirectory)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../obj/packages/$(Configuration)'))</AnalyzerPackageDirectory>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../src/Zongsoft.CodeAnalysis.Analyzers.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
		<None Include="../src/Properties/Resources.resx" Link="Fixtures/Resources.resx" CopyToOutputDirectory="PreserveNewest" />
		<None Include="../src/Properties/Resources.Designer.cs" Link="Fixtures/Resources.Designer.cs" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.CodeAnalysis" HintPath="$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
		<Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyMetadata Include="SdkDirectory" Value="$(NetCoreRoot)sdk/$(NETCoreSdkVersion)" />
		<AssemblyMetadata Include="AnalyzerPackageDirectory" Value="$(AnalyzerPackageDirectory)" />
	</ItemGroup>

	<!-- 准备本项目消费的测试包；Cake 已准备正式包时只读取版本。 -->
	<Target Name="PrepareCodeAnalysisPackage" BeforeTargets="GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
		<MSBuild Projects="../src/Zongsoft.CodeAnalysis.Analyzers.csproj"
			Targets="Pack" Condition="'$(CodeAnalysisPackagePrepared)' != 'true'"
			Properties="Configuration=$(Configuration);PackageOutputPath=$(AnalyzerPackageDirectory)" />
		<MSBuild Projects="../src/Zongsoft.CodeAnalysis.Analyzers.csproj"
			Targets="GetAnalyzerPackageVersion" Properties="Configuration=$(Configuration);PackageOutputPath=$(AnalyzerPackageDirectory)">
			<Output TaskParameter="TargetOutputs" PropertyName="AnalyzerPackageVersion" />
		</MSBuild>
		<Error Condition="!Exists('$(AnalyzerPackageDirectory)/Zongsoft.CodeAnalysis.$(AnalyzerPackageVersion).nupkg')"
			Text="The Zongsoft.CodeAnalysis package must be built before running consumer tests." />
		<ItemGroup>
			<AssemblyMetadata Include="AnalyzerPackageVersion" Value="$(AnalyzerPackageVersion)" />
		</ItemGroup>
	</Target>
</Project>
